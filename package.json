{
  "name": "ruang-kerja-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi proyek, tugas, agenda, dan catatan pribadi berbasis Vue dengan penyimpanan lokal.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check:styles": "node scripts/check-presentation.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run check:styles && npm run format:check"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
